# ROS Navigation
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-slam-toolbox \
    ros-${ROS_DISTRO}-navigation2 \
    ros-${ROS_DISTRO}-nav2-bringup \
    ros-${ROS_DISTRO}-nav2-msgs \
    ros-${ROS_DISTRO}-nav2-rviz-plugins \
    ros-${ROS_DISTRO}-robot-localization \
    ros-${ROS_DISTRO}-pointcloud-to-laserscan \
    ros-${ROS_DISTRO}-laser-filters \
    --fix-missing

# ROS pkgs
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    #ros-${ROS_DISTRO}-diagnostic-updater \ 
    #ros-${ROS_DISTRO}-diagnostic-msgs \
    #ros-${ROS_DISTRO}-statistics-msgs \
    ros-${ROS_DISTRO}-teleop-twist-keyboard \
    ros-${ROS_DISTRO}-imu-tools \
    ros-${ROS_DISTRO}-transmission-interface \
    ros-${ROS_DISTRO}-urdfdom-headers \
    ros-${ROS_DISTRO}-urdf-tutorial \
    ros-${ROS_DISTRO}-backward-ros \
    ros-${ROS_DISTRO}-ros2-control \
    ros-${ROS_DISTRO}-controller-manager \
    ros-${ROS_DISTRO}-ros2-controllers \
    ros-${ROS_DISTRO}-topic-tools \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    ros-${ROS_DISTRO}-can-msgs \
    ros-${ROS_DISTRO}-rosbridge-suite \
    python3-flask \
    --fix-missing

# Pin setuptools: versions >=58.3 break colcon --symlink-install for setup.py packages
RUN pip3 install setuptools==58.2.0 waitress

# Clean up
RUN apt-get clean && rm -rf /var/lib/apt/lists/*

# Initialize rosdep (run as user)
RUN sudo rosdep init || true \
    && rosdep update || true

# Add source in .bashrc
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /home/$USERNAME/.bashrc

USER $USERNAME

RUN mkdir -p /home/$USERNAME/ros2_ws/src

CMD ["bash"]
