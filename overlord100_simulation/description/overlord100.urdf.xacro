        </inertial>
        <collision>
            <geometry>
                <sphere radius= "0.07" />
            </geometry>
        </collision>
    </link>
    
    <joint name="base_link_to_front_right_dummy_wheel" type="fixed">
        <parent link="base_link" />
        <child link="front_right_dummy_wheel" />
        <origin rpy="0 0 0" xyz="0.40 0.23 -0.15" /> 
    </joint>
    
    <link name="back_right_dummy_wheel">
        <visual>
            <origin rpy="0 0 -1.57075" xyz=" 0 0 -0.07" /> 
            <geometry>
                <mesh filename = "package://overlord100_simulation/models/back_right_wheel.dae"  />  
                <!-- <sphere radius="0.2" /> -->
            </geometry>
        </visual>
        <inertial>
            <mass value="1" />
            <inertia ixx="0.016" ixy="0.0" ixz="0.0" iyy="0.016" iyz="0.0" izz="0.016" />
        </inertial>
        <collision>
            <geometry>
                <sphere radius= "0.07" />
            </geometry>
        </collision>
    </link>
    
    <joint name="base_link_to_back_right_dummy_wheel" type="fixed">
        <parent link="base_link" />
        <child link="back_right_dummy_wheel" />
        <origin rpy="0 0 0" xyz="-0.42  0.27 -0.15" /> 
    </joint>
    
    <link name="back_left_dummy_wheel">
        <visual>
            <origin rpy="0 0 -1.57075" xyz=" 0 0 -0.07" /> 
            <geometry>
