<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro" name="overlord100">

    <!-- Include Gazebo Parameters -->
    <xacro:include filename="$(find overlord100_simulation)/description/overlord100_gazebo.xacro" />

    <!-- Include ROS2 Control -->
    <xacro:include filename="$(find overlord100_simulation)/description/overlord100_control.xacro" />

    <link name="base_footprint"/>

    <link name="base_link">
        <visual>
            <origin rpy="0 0 -1.57075" xyz="0 0 -0.20" />
            <geometry>
                <mesh filename="package://overlord100_simulation/models/base.dae"/>
            </geometry>
        </visual>

        <inertial>
            <mass value="60.5" />
            <inertia ixx="0.45375" ixy="0.0" ixz="0.0" iyy="2.263304" iyz="0.0" izz="2.716954" />
        </inertial>

        <collision>
            <geometry>
                <box size="0.93 0.67 0.2" />
            </geometry>
        </collision>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin rpy="0 0 0" xyz="0 0 0.20" />
    </joint>

    <!-- wheels -->
    <link name="left_wheel">
        <visual>
            <origin rpy="0 0 -1.57075" xyz="0 0 -0.0655" />
            <geometry>
                <mesh filename = "package://overlord100_simulation/models/left_wheel.dae"  />  
            </geometry>
        </visual>

        <inertial>
            <mass value="1" />
            <inertia ixx="0.0175" ixy="0.0" ixz="0.0" iyy="0.0175" iyz="0.0" izz="0.02" />
        </inertial>
        <collision>
            <origin rpy="1.57075 0 0" xyz="0 0 0" /> 
            <geometry>
                <cylinder radius = "0.07" length = "0.06" />
            </geometry>
        </collision>
    </link>
    
    <joint name="base_link_to_left_wheel" type="continuous">
        <axis xyz="0 1 0" />
        <limit effort="1000.0" lower="-1.79769e+308" upper="1.79769e+308" velocity="100.0" />
        <parent link="base_link" />
        <child link="left_wheel" />
        <origin rpy="0 0 0" xyz="-0.045 0.33 -0.15" />
    </joint>
    
    <link name="right_wheel">
        <visual>
            <origin rpy="0 0 -1.57075" xyz="0 0 -0.0655" />
            <geometry>
                <mesh filename = "package://overlord100_simulation/models/right_wheel.dae"/>
            </geometry>
        </visual>
        <inertial>
            <mass value="1" />
            <inertia ixx="0.0175" ixy="0.0" ixz="0.0" iyy="0.0175" iyz="0.0" izz="0.02" />
        </inertial>
        <collision>
            <origin rpy="1.57075 0 0" xyz="0 0 0" />
            <geometry>
                <cylinder radius = "0.07" length = "0.06" />
            </geometry>
        </collision>
    </link>

    <joint name="base_link_to_right_wheel" type="continuous">
        <axis xyz="0 1 0" />
        <limit effort="1000.0" lower="-1.79769e+308" upper="1.79769e+308" velocity="100.0" />
        <parent link="base_link" />
        <child link="right_wheel" />
        <origin rpy="0 0 0" xyz="-0.045 -0.33 -0.15" />
    </joint>

    <link name="front_left_dummy_wheel">
        <visual>
        <origin rpy="0 0 -1.57075" xyz=" 0 0 -0.07" /> 
            <geometry>
                <mesh filename = "package://overlord100_simulation/models/front_left_wheel.dae" />
                <!-- <sphere radius="0.2" /> -->
            </geometry>
        </visual>
        <inertial>
            <mass value="1" />
            <inertia ixx="0.016" ixy="0.0" ixz="0.0" iyy="0.016" iyz="0.0" izz="0.016" />
        </inertial>
        <collision>
            <geometry>
                <sphere radius= "0.07" />
            </geometry>
        </collision>
    </link>
    
    <joint name="base_link_to_front_left_dummy_wheel" type="fixed">
        <parent link="base_link" />
            <child link="front_left_dummy_wheel" />
        <origin rpy="0 0 0" xyz="0.40 -0.23 -0.15" />
    </joint>
    
    <link name="front_right_dummy_wheel">
