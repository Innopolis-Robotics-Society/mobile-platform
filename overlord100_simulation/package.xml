<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>overlord100_simulation</name>
  <version>0.0.0</version>
  <description>This package contains data for simulating the Overlord 100 mobile platform, but
    third-party products can also be launched through launch options</description>
  <maintainer email="e.shlomov@innopolis.university">Overlord100_simulation_team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>ign</depend>
  <depend>gazebo_ros</depend>
  <depend>nav_msgs</depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ign_ros2_control</exec_depend>


  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>

    <build_type>ament_python</build_type>
  </export>
</package>
